{
  "name": "@financeApp/api",
  "author": "João Canezin <joao.canezin22@gmail.com>",
  "version": "1.0.0",
  "description": "API para a aplicação de gerenciamento financeiro pessoal.",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsx watch --env-file=.env src/http/server.ts",
    "start": "node --env-file=.env dist/http/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@fastify/autoload": "6.5.0",
    "@types/node": "26.4.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "fastify-type-provider-zod": "6.1.0",
    "globals": "17.12.0",
    "neostandard": "0.13.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sse": "0.6.0",
    "@google/genai": "2.21.0",
    "better-auth": "1.7.2",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-better-auth": "1.2.0",
    "fastify-plugin": "6.0.0",
    "nodemailer": "9.1.1",
    "postgres": "3.4.9",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  }
}
