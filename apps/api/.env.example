NODE_ENV=development
PORT=3333
# Em produção (container, proxy reverso) use 0.0.0.0
HOST=127.0.0.1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_app

DOCKER_PG_PORT=5432
DOCKER_PG_USER=postgres
DOCKER_PG_PASSWORD=postgres
DOCKER_PG_DB=finance_app


BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
FRONTEND_URL=http://localhost:4565

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FinanceApp
SMTP_FROM_EMAIL=

APPLICATION_TIMEZONE=America/Cuiaba

# Opcional — chat financeiro com IA fica desabilitado (erro amigável) sem isso
GEMINI_API_KEY=
